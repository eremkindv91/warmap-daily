{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WarMap Daily News & Information Compression Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "timestamp",
      "importance",
      "verification_status",
      "confidence",
      "what_happened",
      "what_is_confirmed",
      "what_is_not_confirmed",
      "independent_sources_count"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "title_uk": { "type": "string" },
      "title_en": { "type": "string" },
      "sector_id": { "type": "string" },
      "settlement_name": { "type": "string" },
      "timestamp": { "type": "string" },
      "time_formatted": { "type": "string" },
      "importance": { "enum": ["critical", "important", "context"] },
      "verification_status": { "enum": ["CONFIRMED", "PROBABLE", "UNCONFIRMED", "CONTRADICTED", "REJECTED"] },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "what_happened": { "type": "string" },
      "what_happened_uk": { "type": "string" },
      "what_happened_en": { "type": "string" },
      "what_is_confirmed": { "type": "string" },
      "what_is_not_confirmed": { "type": "string" },
      "independent_sources_count": { "type": "integer", "minimum": 0 },
      "raw_publications_compressed": { "type": "integer", "minimum": 1 },
      "sources_lineage": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "type", "independent", "confirms"],
          "properties": {
            "name": { "type": "string" },
            "type": { "enum": ["official", "osint", "media", "satellite", "geolocation", "video", "social", "independent"] },
            "independent": { "type": "boolean" },
            "confirms": { "type": "string" },
            "timestamp": { "type": "string" }
          }
        }
      }
    }
  }
}
